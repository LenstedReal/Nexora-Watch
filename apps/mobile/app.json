{
  "expo": {
    "name": "Nexora Watch",
    "slug": "nexora-watch",
    "scheme": "nexora",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090D",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090D"
    },
    "android": {
      "package": "com.lenstedreal.nexorawatch",
      "versionCode": 80000,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090D"
      },
      "permissions": ["android.permission.INTERNET", "android.permission.ACCESS_NETWORK_STATE"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "ios": {
      "bundleIdentifier": "com.lenstedreal.nexorawatch",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSPhotoLibraryUsageDescription": "Odaya video yüklemek için galerine erişim gerekiyor."
      }
    },
    "plugins": [
      ["expo-video", { "supportsBackgroundPlayback": false, "supportsPictureInPicture": true }],
      ["expo-image-picker", { "photosPermission": "Odaya video yüklemek için galerine erişim gerekiyor." }],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }],
      "expo-secure-store"
    ]
  }
}
