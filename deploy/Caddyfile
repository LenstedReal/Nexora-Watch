# DOMAIN          -> web app + /api (FastAPI backend, WebSocket included)
# PERSONAL_DOMAIN -> static personal site
{$DOMAIN} {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle /api/* {
		reverse_proxy backend:8001
	}
	handle {
		root * /srv/web
		@static path /static/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

{$PERSONAL_DOMAIN} {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	root * /srv/personal
	try_files {path} {path}.html {path}/index.html /index.html
	file_server
}
